// Standard views are ordinary imported Tao declarations.
// Project dependency declarations live in ../Dependencies.tao.
use tao@ui all
use ModuleCaption
use tao@ui Text as Caption
use package tao@ui as UI
use ModuleCaption as ImportedCaption
use package ./Modules
use ./Library LibraryGreeting

file
let DefaultTitle is text = "Kitchen Sink"

app KitchenSink {
  root RootView
}

view RootView {
  let Title = DefaultTitle
  render Col {
    Heading
    PrivateGreeting
    LibraryGreeting("Typed", "TypeScript props")
    Text(Title)
    Text(Modules.ModuleCaption)
    Text(ModuleCaption)
    Text(ImportedCaption)
    SidecarGreeting("Validated TypeScript sidecar")
    Col {
      let Title = "Nested lexical scope"
      Text(Title)
    }
    #editable
    Input("Original")
    #save
    SaveButton
    Col [disabled yes] {
      SaveButton [disabled no]
      Input("Disabled by its container")
    }
      InteractionStatus(yes)
    Text("Text: \"quotes\", a backslash \\, Unicode \u263A\nand a new line")
    Panel("Nested children and aliased captures") {
      Pair("First parameter", "Second parameter")
      Row() {
        Caption("Left")
        UI.Text("Right")
      }
    }
  }

  view PrivateGreeting {
    render Text("Private nested view")
  }
}

view InteractionStatus(Locked boolean) {
  let Status = Locked
  render inject Status ```ts
    const locked: boolean = Status
    return <Tao.Text>{locked ? 'Controls locked' : 'Controls unlocked'}</Tao.Text>
  ```
}

folder
view Pair(First text, Second text) {
  let FirstCaption = First
  render Col {
    Text(FirstCaption)
    Text(Second)
  }
}

package
view Panel(Title text) {
  /* Injections explicitly capture their Tao values and contextual children. */
  render inject Caption Title, Children @@children ```ts
    return (
      <Tao.View style={{ padding: 12, borderWidth: 1 }}>
        <Tao.Text>{Caption}</Tao.Text>
        {Children}
      </Tao.View>
    )
  ```
}

project
view Heading {
  render inject ```ts
    return <Tao.Text style={{ fontSize: 24 }}>Kitchen Sink</Tao.Text>
  ```
}

public
view SaveButton {
  render inject ```ts
    const status = Tao.useWritable(() => ({ captions: ['Save'] }))
    const snapshot = Tao.useValue(status)
    return (
      <Tao.Pressable onPress={() => status.update({ captions: ['Saved'] })}>
        <Tao.Text>{snapshot.captions[0]}</Tao.Text>
      </Tao.Pressable>
    )
  ```
}

public
view SidecarGreeting(Value text) from ./SidecarGreeting.tsx

tests "Kitchen Sink" {
  test(Label "Tagged input and control") {
    run KitchenSink
    expect text "Kitchen Sink"
    expect text "Private nested view"
    expect text "Sidecar: Validated TypeScript sidecar"
    expect text "Nested lexical scope"
    type "Edited text" into #editable
    press #save
    expect {
      text "Saved"
    }
    expect #editable input value "Edited text"
  }
}
