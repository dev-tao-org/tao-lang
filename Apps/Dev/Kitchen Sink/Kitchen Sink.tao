// Standard views are ordinary imported Tao declarations.
use all from tao@ui
use Text as Caption from tao@ui
use package tao@ui as UI
use ModuleCaption
use ModuleCaption as ImportedCaption from ./Modules

file let DefaultTitle is text = "Kitchen Sink"

app KitchenSink {
  root RootView
}

view RootView {
  let Title = DefaultTitle
  render Col {
    Heading
    Text(Title)
    Text(ModuleCaption)
    Text(ImportedCaption)
    SidecarGreeting("Validated TypeScript sidecar")
    Col {
      let Title = "Nested lexical scope"
      Text(Title)
    }
    #editable Input("Original")
    #save SaveButton
    Text("Text: \"quotes\", a backslash \\, Unicode \u263A\nand a new line")
    Panel("Nested children and aliased captures") {
      Pair("First parameter", "Second parameter")
      Row() {
        Caption("Left")
        UI.Text("Right")
      }
    }
  }
}

folder view Pair(First text, Second text) {
  let FirstCaption = First
  render Col {
    Text(FirstCaption)
    Text(Second)
  }
}

package view Panel(Title text) {
  /* Injections explicitly capture their Tao values and contextual children. */
  render inject Caption Title, Children @@children ```ts
    return <TR.ReactNative.View style={{ padding: 12, borderWidth: 1 }}>
      <TR.ReactNative.Text>{Caption}</TR.ReactNative.Text>
      {Children}
    </TR.ReactNative.View>
  ```
}

project view Heading {
  render inject ```ts
    return <TR.ReactNative.Text style={{ fontSize: 24 }}>Kitchen Sink</TR.ReactNative.Text>
  ```
}

public view SaveButton {
  render inject ```ts
    const [saved, setSaved] = TR.React.useState(false)
    return <TR.ReactNative.Pressable onPress={() => setSaved(true)}>
      <TR.ReactNative.Text>{saved ? 'Saved' : 'Save'}</TR.ReactNative.Text>
    </TR.ReactNative.Pressable>
  ```
}

public view SidecarGreeting(Value text) from ./SidecarGreeting.tsx

tests "Kitchen Sink" {
  test "Tagged input and control" {
    run KitchenSink
    expect text "Kitchen Sink"
    expect text "Sidecar: Validated TypeScript sidecar"
    expect text "Nested lexical scope"
    type "Edited text" into #editable
    press #save
    expect { text "Saved" }
    expect #editable { input value "Edited text" }
  }
}
