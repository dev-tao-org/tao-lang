app KitchenSink {
  root RootView
}

view RootView {
  render Col {
    Heading
    #editable Input
    #save SaveButton
    Text("Text: \"quotes\", a backslash \\, Unicode \u263A\nand a new line")
    Panel("Nested children and aliased captures") {
      Pair("First parameter", "Second parameter")
      Row() {
        Text("Left")
        Text("Right")
      }
    }
  }
}

view Pair(First text, Second text) {
  render Col {
    Text(First)
    Text(Second)
  }
}

view Text(Value text) {
  render inject Value ```ts
    return <TR.ReactNative.Text>{Value}</TR.ReactNative.Text>
  ```
}

view Panel(Title text) {
  render inject Caption Title, Children @@children ```ts
    return <TR.ReactNative.View style={{ padding: 12, borderWidth: 1 }}>
      <TR.ReactNative.Text>{Caption}</TR.ReactNative.Text>
      {Children}
    </TR.ReactNative.View>
  ```
}

view Col() {
  render inject Children @@children ```ts
    return <TR.ReactNative.View style={{ flexDirection: 'column', gap: 8 }}>{Children}</TR.ReactNative.View>
  ```
}

view Row {
  render inject Children @@children ```ts
    return <TR.ReactNative.View style={{ flexDirection: 'row', gap: 16 }}>{Children}</TR.ReactNative.View>
  ```
}

view Heading {
  render inject ```ts
    return <TR.ReactNative.Text style={{ fontSize: 24 }}>Kitchen Sink</TR.ReactNative.Text>
  ```
}

view Input {
  render inject ```ts
    return <TR.ReactNative.TextInput defaultValue="Original" accessibilityLabel="Editable text" />
  ```
}

view SaveButton {
  render inject ```ts
    const [saved, setSaved] = TR.React.useState(false)
    return <TR.ReactNative.Pressable onPress={() => setSaved(true)}>
      <TR.ReactNative.Text>{saved ? 'Saved' : 'Save'}</TR.ReactNative.Text>
    </TR.ReactNative.Pressable>
  ```
}

tests "Kitchen Sink" {
  test "Tagged input and control" {
    run KitchenSink
    expect text "Kitchen Sink"
    type "Edited text" into #editable
    press #save
    expect { text "Saved" }
    expect #editable { input value "Edited text" }
  }
}
