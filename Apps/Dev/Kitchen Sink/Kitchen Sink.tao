// Standard views are ordinary imported Tao declarations.
// Project dependency declarations live in ../Dependencies.tao.
use tao@ui Button, Col, Input, Row, Text, Text as Caption
use ModuleCaption, ModuleCaption as ImportedCaption
use @examples/details PackageBadge
use ./Library LibraryGreeting

type Label is text
type CaptionValue = text
type Score is number
type Total = number

file
let DefaultTitle = Label "Kitchen Sink" as text

app KitchenSink {
  root RootView
}

view RootView {
  let Title = DefaultTitle
  render Col {
    Heading
    PrivateGreeting
    LibraryGreeting("Typed", "TypeScript props")
    Text(Title)
    PackageBadge
    Text(ModuleCaption)
    Text(ImportedCaption)
    SidecarGreeting("Validated TypeScript sidecar")
    Col {
      let Title = "Nested lexical scope"
      Text(Title)
    }
    #editable
    Input("Original")
    SaveButton
    Text("Text: \"quotes\", a backslash \\, Unicode \u263A\nand a new line")
    Panel("Nested children and aliased captures") {
      Pair("First parameter", "Second parameter")
      Row() {
        Caption("Left")
        Text("Right")
      }
    }
  }

  view PrivateGreeting {
    render Text("Private nested view")
  }
}

folder
view Pair(First text, Second text) {
  let FirstCaption = First
  render Col {
    Text(FirstCaption)
    Text(Second)
  }
}

package
view Panel(Title text) {
  /* Injections explicitly capture their Tao values and contextual children. */
  render inject Caption Title, Children @@children ```ts
    return (
      <Tao.View style={{ padding: 12, borderWidth: 1 }}>
        <Tao.Text>{Caption}</Tao.Text>
        {Children}
      </Tao.View>
    )
  ```
}

package
view Heading {
  render inject ```ts
    return <Tao.Text style={{ fontSize: 24 }}>Kitchen Sink</Tao.Text>
  ```
}

package
view SaveButton {
  state Caption = "Save"
  state Total Points = Score 2
  action Save() {
    set Caption = "Saved"
    set Points = 7
  }
  render Col {
    #save
    Button(Caption) {
      on press Save
    }
    ScoreReadout(Points)
  }
}

view ScoreReadout(Value number) {
  render inject Value ```ts
    return <Tao.Text>{'Points: ' + Value.toString()}</Tao.Text>
  ```
}

package
view SidecarGreeting(Value CaptionValue) from ./SidecarGreeting.tsx

tests "Kitchen Sink" {
  test(Label "Tagged input and control") {
    run KitchenSink
    expect text "Kitchen Sink"
    expect text "Points: 2"
    expect text "Private nested view"
    expect text "Named package subfolder"
    expect text "Sidecar: Validated TypeScript sidecar"
    expect text "Nested lexical scope"
    type "Edited text" into #editable
    press #save
    expect {
      text "Saved"
    }
    expect text "Points: 7"
    expect #editable input value "Edited text"
  }
}
