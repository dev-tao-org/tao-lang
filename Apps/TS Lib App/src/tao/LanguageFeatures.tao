use tao@ui Button, Col, Input, Text, Text as AliasText
use @cards Caption, Caption as PackageCaption
use @cards/details DetailedCard
use FolderScope, PackageScope

file
let FileCaption is text = "File-scoped text"

file
let EscapedCaption = "Escaped \"text\", backslash \\ and Unicode \u263A"

package
view LanguageFeatures(Name text) {
  render Col {
    Text(FileCaption)
    FolderScope
    PackageScope
    Caption("Package import")
    AliasText("Tao alias")
    PackageCaption("Aliased package import")
    DetailedCard("Tao import from a package subfolder")
    Col {
      let FileCaption = "Nested lexical text"
      Text(FileCaption)
    }
    CapturedCaption(Name)
    ForeignGreeting(Name)
    #libraryInput
    Input("Library input")
    Text(EscapedCaption)
    #state-first
    StateEditor(Name)
    #state-second
    StateEditor("Second initial state")
  }

  view CapturedCaption(Value text) {
    render inject Caption Value ```ts
      return <Tao.Text>{'Aliased capture: ' + Caption}</Tao.Text>
    ```
  }

  view StateEditor(Initial text) {
    state Status = Initial
    action Save() {
      set Status = "Saved state"
    }
    action Reset() {
      set Status = Initial
    }
    render Col {
      Text(Status)
      Button("Save state") {
        on press Save
      }
      Button("Read current input") {
        on press -> do Reset()
      }
    }
  }
}

view ForeignGreeting(Value text) from ../ts/ForeignGreeting.tsx
