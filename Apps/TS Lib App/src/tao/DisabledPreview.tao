use tao@ui Col, Input

public view DisabledPreview(Locked boolean) {
   let Status = Locked
   render Col [disabled Locked] {
      CapturedStatus
      DisabledPreviewControls(Locked) [disabled no]
      #previewInput
      Input("Editable")
   }

   view CapturedStatus {
      render inject Status ```ts
         const locked: boolean = Status
         return <Tao.Text>{locked ? 'Captured locked' : 'Captured unlocked'}</Tao.Text>
      ```
   }
}

file view DisabledPreviewControls(Locked boolean) from ./DisabledPreviewControls.tsx
