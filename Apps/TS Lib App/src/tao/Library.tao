use tao@ui Col, Text
use package ./cards as Cards
use LanguageFeatures

ts-library Demo {
  publish { Greeting, Panel, LanguageFeatures, Cards as Catalog, }
}

public
view Greeting(First text, Second text) {
  render Col {
    Text(First)
    PrivateGreeting
    Text(Second)
  }

  view PrivateGreeting {
    render inject ```ts
      const count = Tao.useWritable(() => 0)
      const value = Tao.useValue(count)
      const caption = Tao.useComputed(() => 'Nested private Tao helper ' + count.jsValue(), [count])
      const label = Tao.useValue(caption)
      return (
        <Tao.Pressable onPress={() => count.update(value + 1)}>
          <Tao.Text>{label}</Tao.Text>
        </Tao.Pressable>
      )
    ```
  }
}

public
view Panel {
  render inject Children @@children ```ts
    return <Tao.View>{Children}</Tao.View>
  ```
}

view Hidden {
  render Text("Unpublished")
}
