{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "preserveSymlinks": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["react", "bun"]
  },
  "include": ["*.tsx", "test/**/*.ts", "test/**/*.tsx"],
  "extends": "expo/tsconfig.base"
}
