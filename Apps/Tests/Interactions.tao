use Col, Input from @tao/ui

app Interactions {
  root Form
}

view Form {
  render Col {
    #name Input("Original")
    #save Button
  }
}

view Button {
  render inject ```ts
    const [pressed, setPressed] = TR.React.useState(false)
    return <TR.ReactNative.Pressable onPress={() => setPressed(true)}>
      <TR.ReactNative.Text>{pressed ? 'Saved' : 'Ready'}</TR.ReactNative.Text>
    </TR.ReactNative.Pressable>
  ```
}

tests "App interactions" {
  test "Edits and presses tagged renders" {
    run Interactions
    expect text "Ready"
    expect #name input value "Original"
    type "Hello World" into #name
    press #save
    expect {
      text "Saved"
    }
    expect #name {
      input value "Hello World"
    }
  }
  test(Label "Each case starts fresh") {
    run Interactions
    expect text "Ready"
    expect #name input value "Original"
  }
}
