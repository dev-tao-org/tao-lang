use Col, Input from tao@ui

app Interactions {
  root Form
}

view Form {
  render Col {
    #name
    Input("Original")
    #save
    Button
  }
}

view Button {
  render inject ```ts
    const pressed = Tao.useWritable(() => false)
    const isPressed = Tao.useValue(pressed)
    return (
      <Tao.Pressable onPress={() => pressed.update(true)}>
        <Tao.Text>{isPressed ? 'Saved' : 'Ready'}</Tao.Text>
      </Tao.Pressable>
    )
  ```
}

tests "App interactions" {
  test "Edits and presses tagged renders" {
    run Interactions
    expect text "Ready"
    expect #name input value "Original"
    type "Hello World" into #name
    press #save
    expect {
      text "Saved"
    }
    expect #name {
      input value "Hello World"
    }
  }
  test(Label "Each case starts fresh") {
    run Interactions
    expect text "Ready"
    expect #name input value "Original"
  }
}
