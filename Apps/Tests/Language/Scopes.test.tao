use Language

tests "Lexical scopes" {
  test "Nearest value and isolated child blocks" {
    run Language
    expect #file {
      text "File scope"
    }
    expect #inner {
      text "Nested scope"
    }
    expect #native {
      text "File scope"
    }
    expect #deep {
      text "Deep scope"
    }
    expect #sibling {
      text "File scope"
    }
    expect text "Parameter scope"
    expect text "Second file binding"
  }
}
