use tao@ui Col, Text
use tao@ui Button as Control

type Score is number
type PriorityScore is Score
type Points = number
type Total = Points

folder
view TextStateActions {
  render Editor("Original message")
}

view Editor(Initial text) {
  state Message = Initial
  state Status = Initial
  state PointsShown = PriorityScore 2 as Score as Total
  let Caption = Message

  action Rename() {
    do SetMessage("Renamed")
    set Status = Caption
    set PointsShown = 7
  }

  action SetMessage(Value text) {
    set Message = Value
  }

  action Reset() {
    set Message = Initial
    set Status = Caption
  }

  render Col {
    Text(Status)
    ScoreReadout(PointsShown)
    Controls
  }

  view Controls {
    render Col {
      #rename-editor
      Control("Rename") {
        on press Rename
      }
      #reset-editor
      Control("Reset") {
        on press -> do Reset()
      }
      #inline-editor
      Control("Set inline") {
        on press -> set Status = "Inline message"
        let Status = "Later render binding"
      }
    }
  }
}

view ScoreReadout(Value number) {
  render inject Value ```ts
    return <Tao.Text>{'Points: ' + Value.toString()}</Tao.Text>
  ```
}
