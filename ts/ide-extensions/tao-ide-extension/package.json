{
  "name": "@tao/ide-extension",
  "displayName": "Tao Language Support",
  "version": "0.0.1",
  "description": "Incremental Tao syntax diagnostics and highlighting for VS Code.",
  "categories": [
    "Programming Languages"
  ],
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.100.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "tao",
        "aliases": [
          "Tao"
        ],
        "extensions": [
          ".tao"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tao-light.svg",
          "dark": "./icons/tao-dark.svg"
        }
      }
    ],
    "configurationDefaults": {
      "[tao]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.defaultFormatter": "devtao.tao",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
      }
    }
  },
  "files": [
    "dist/**",
    "runtime/**",
    "grammars/**",
    "queries/**",
    "icons/**",
    "language-configuration.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tao-dev-org/tao-lang.git"
  },
  "dependencies": {
    "@tao/fix": "workspace:*",
    "@tao/source-validation": "workspace:*",
    "web-tree-sitter": "0.26.6",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/vscode": "1.110.0",
    "@vscode/vsce": "3.7.1"
  },
  "exports": {
    ".": "./tao-ide-extension-src/Editor.ts"
  },
  "tao": {
    "publicApi": {
      ".": {
        "alias": "@ide",
        "namespace": "IDE"
      }
    }
  }
}
