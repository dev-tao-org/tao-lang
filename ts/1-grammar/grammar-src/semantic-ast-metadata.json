{
  "semanticNames": {
    "Identifier": "Name",
    "InputValueExpectation": "InputExpectation",
    "QualifiedName": "Name",
    "InjectionCapture": "Capture"
  },
  "semanticFieldNames": {
    "ViewRenderExpression": {
      "argumentList": "arguments",
      "view": "target"
    }
  },
  "requiredFields": {
    "UseStatement": ["all"],
    "Capture": ["value"]
  },
  "fieldTypeOverrides": {
    "AppDeclaration": {
      "block": "AppDeclarationBlock"
    },
    "Capture": {
      "value": "CaptureValue"
    },
    "ExpectStatement": {
      "block": "ExpectationBlock | undefined",
      "expectation": "Expectation | undefined"
    },
    "File": {
      "block": "DeclarationBlock"
    },
    "Injection": {
      "captures": "readonly Capture[]"
    },
    "InputExpectation": {
      "target": "RenderTag | undefined"
    },
    "TestDeclaration": {
      "block": "TestBlock"
    },
    "TestsDeclaration": {
      "block": "TestsBlock"
    },
    "ViewDeclaration": {
      "body": "ViewDeclarationImplementation",
      "parameters": "readonly Parameter[]"
    },
    "ViewRenderExpression": {
      "block": "ViewRenderBlock | undefined",
      "arguments": "readonly Expression[]"
    },
    "UseStatement": {
      "all": "boolean"
    }
  },
  "blocks": {
    "DeclarationBlock": { "members": ["_Declaration"] },
    "AppDeclarationBlock": { "members": ["RootDeclaration"] },
    "ViewDeclarationBlock": {
      "statementUnion": "ViewDeclarationStatement",
      "members": ["LetDeclaration", "_ViewRenderStatement"]
    },
    "ViewRenderBlock": {
      "statementUnion": "ViewRenderBlockStatement",
      "members": ["LetDeclaration", "ViewRenderExpression"]
    },
    "TestsBlock": { "members": ["TestDeclaration"] },
    "TestBlock": { "members": ["RunStatement", "PressStatement", "TypeStatement", "ExpectStatement"] },
    "ExpectationBlock": { "members": ["TextExpectation", "InputValueExpectation"] }
  },
  "unions": {
    "CaptureValue": ["Name", "ContextReference"],
    "TestStep": ["RunStatement", "PressStatement", "TypeStatement", "ExpectStatement"],
    "Expectation": ["TextExpectation", "InputExpectation"],
    "ValueDeclaration": ["AppDeclaration", "ViewDeclaration", "LetDeclaration"]
  }
}
