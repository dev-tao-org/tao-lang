{
  "semanticNames": {
    "Identifier": "Name",
    "InputValueExpectation": "InputExpectation",
    "QualifiedName": "Name",
    "InjectionCapture": "Capture"
  },
  "semanticFieldNames": {
    "DoStatement": {
      "argumentList": "arguments"
    },
    "ViewRenderExpression": {
      "argumentList": "arguments",
      "view": "target"
    }
  },
  "requiredFields": {
    "Capture": ["value"]
  },
  "cstOnlyFields": {
    "StateDeclaration": ["type"]
  },
  "fieldTypeOverrides": {
    "ActionDeclaration": {
      "parameters": "readonly Parameter[]"
    },
    "DoStatement": {
      "arguments": "readonly Expression[]"
    },
    "InlineAction": {
      "body": "InlineActionBody"
    },
    "Capture": {
      "value": "CaptureValue"
    },
    "ExpectStatement": {
      "block": "Block | undefined",
      "expectation": "Expectation | undefined"
    },
    "Injection": {
      "captures": "readonly Capture[]"
    },
    "PressBinding": {
      "handler": "PressHandler"
    },
    "InputExpectation": {
      "target": "RenderTag | undefined"
    },
    "ViewDeclaration": {
      "body": "ViewDeclarationImplementation",
      "parameters": "readonly Parameter[]"
    },
    "ViewRenderExpression": {
      "arguments": "readonly Expression[]"
    }
  },
  "unions": {
    "ActionStatement": ["SetStatement", "DoStatement"],
    "InlineActionBody": ["Block", "SetStatement", "DoStatement"],
    "PressHandler": ["Name", "InlineAction"],
    "CaptureValue": ["Name", "ContextReference"],
    "TestStep": ["RunStatement", "PressStatement", "TypeStatement", "ExpectStatement"],
    "Expectation": ["TextExpectation", "InputExpectation"],
    "ValueDeclaration": ["AppDeclaration", "ViewDeclaration", "LetDeclaration"],
    "ViewValueDeclaration": ["LetDeclaration", "StateDeclaration"],
    "ViewDeclarationStatement": [
      "LetDeclaration",
      "StateDeclaration",
      "ActionDeclaration",
      "_ViewRenderStatement",
      "ViewDeclaration"
    ],
    "ViewRenderBlockStatement": ["LetDeclaration", "PressBinding", "ViewRenderExpression"]
  }
}
