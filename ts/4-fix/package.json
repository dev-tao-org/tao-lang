{
  "name": "@tao/fix",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@dprint/formatter": "0.5.1",
    "@tao/ast-gen": "workspace:*",
    "@tao/grammar": "workspace:*",
    "@tao/shared": "workspace:*",
    "tree-sitter": "0.25.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0"
  },
  "exports": {
    "./embedded": "./fix-src/lib/formatter/Embedded.ts",
    ".": "./fix-src/Fix.ts",
    "./format": "./fix-src/Fix/Format.ts"
  },
  "tao": {
    "publicApi": {
      "./embedded": {
        "alias": "@fix/embedded",
        "namespace": "Embedded"
      },
      ".": {
        "alias": "@fix",
        "namespace": "Fix"
      },
      "./format": {
        "alias": "@fix/format",
        "namespace": "Format"
      }
    }
  }
}
