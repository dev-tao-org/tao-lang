#!/bin/sh
# Explicit noninteractive Linux tool activation; repository dependencies stay in ./agent unsandboxed setup.
set -eu

tools_only=false
install_nix=false
verify_setup=false
for argument in "$@"; do
  case "$argument" in
    --tools-only) tools_only=true ;;
    --install-nix) install_nix=true ;;
    --verify-setup) verify_setup=true ;;
    --help)
      printf 'Usage: ./.config/bootstrap-tao-dev-env [--install-nix] [--tools-only | --verify-setup]\n'
      printf 'Build the locked portable Linux profile, then run ./agent unsandboxed setup.\n'
      printf 'Use --tools-only to prepare a reusable tools image without repository dependencies.\n'
      printf 'Use --verify-setup to prepare the retained legacy verification lane.\n'
      exit 0 ;;
    *) printf 'Unknown bootstrap option: %s\n' "$argument" >&2; exit 2 ;;
  esac
done

checkout=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
# Root setup installs the TypeScript workspace; --verify-setup explicitly selects the legacy lane.
# Ordinary root setup owns its portable tools independently of the reference implementation.
environment="$checkout/.config/nix"
if [ -f "$checkout/ts/package.json" ] && ! "$verify_setup"; then
  repository="$checkout"
  state_dir="$checkout/.devenv"
elif [ -f "$checkout/.x-tao-old-v1/package.json" ] && [ -d "$checkout/.x-tao-old-v1/packages" ]; then
  repository="$checkout/.x-tao-old-v1"
  state_dir="$checkout/.devenv/.x-tao-old-v1"
  environment="$repository/packages/cli/dev-cli/dev-cli-src/environment"
else
  repository="$checkout"
  state_dir="$checkout/.devenv"
fi
cd "$repository"
if [ "$(uname -s)" != Linux ]; then
  printf 'Portable bootstrap supports Linux. On macOS use ./enter-tao-dev-env.sh.\n' >&2
  exit 1
fi

if "$install_nix"; then
  # The installer waits for an active installation before judging its pending marker.
  /bin/sh "$environment/nix-bootstrap.sh"
fi
if [ -f "$HOME/.local/state/tao-contributor/nix-bootstrap.pending" ]; then
  printf 'A previous Nix bootstrap did not complete. Recreate the disposable environment or recover its recorded installation before retrying.\n' >&2
  exit 1
fi

# Discover an installed Nix without assuming setup-shell exports survive the next cloud process.
if ! command -v nix-build >/dev/null 2>&1; then
  for nix_bin in "$HOME/.nix-profile/bin" /nix/var/nix/profiles/default/bin; do
    if [ -x "$nix_bin/nix-build" ]; then
      PATH="$nix_bin:$PATH"
      export PATH
      break
    fi
  done
fi
if ! command -v nix-build >/dev/null 2>&1; then
  printf 'Nix is missing. In a disposable Linux environment run ./.config/bootstrap-tao-dev-env --install-nix.\n' >&2
  exit 1
fi

# Only our fresh single-user container installation needs these process-local settings. A marker
# records the exact binary so an unrelated preinstalled Nix keeps its own daemon/build policy.
managed_nix_marker="$HOME/.local/state/tao-contributor/nix-bootstrap"
if [ -f "$managed_nix_marker" ]; then
  managed_nix_binary=
  IFS= read -r managed_nix_binary < "$managed_nix_marker" || true
  resolved_nix_binary=$(readlink -f "$(command -v nix-build)")
  if [ -n "$managed_nix_binary" ] && [ "$managed_nix_binary" = "$resolved_nix_binary" ]; then
    NIX_CONFIG="${NIX_CONFIG:-}
store = local
build-users-group =
sandbox = false"
    export NIX_CONFIG
  fi
fi

for required in flock sha256sum; do
  if ! command -v "$required" >/dev/null 2>&1; then
    printf 'Portable bootstrap needs %s from the Linux base image.\n' "$required" >&2
    exit 1
  fi
done

mkdir -p "$state_dir/portable-generations"
exec 9>"$state_dir/portable-bootstrap.lock"
flock -w 600 9 || { printf 'Timed out waiting for portable bootstrap.\n' >&2; exit 1; }

# Keep each generation rooted in the Nix store, including generations used by concurrent commands.
identity=$({
  uname -sm
  cat devenv.lock "$environment/toolchain-packages.nix" "$environment/portable-profile.nix"
} | sha256sum)
identity=${identity%% *}
generation="$state_dir/portable-generations/$identity"
if [ ! -x "$generation/bin/bun" ] || [ ! -x "$generation/bin/node" ] || [ ! -x "$generation/bin/zsh" ]; then
  printf 'Portable bootstrap: building locked Linux tools...\n' >&2
  nix-build "$environment/portable-profile.nix" --out-link "$generation"
fi

if [ -e "$state_dir/profile" ] && [ ! -L "$state_dir/profile" ]; then
  printf 'Refusing to replace .devenv/profile because it is not a symbolic link.\n' >&2
  exit 1
fi
publication="$state_dir/portable-profile-next-$$"
trap 'rm -f "$publication"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
ln -s "portable-generations/$identity" "$publication"
mv -Tf "$publication" "$state_dir/profile"
flock -u 9
exec 9>&-

if "$tools_only"; then
  exit 0
fi
PATH="$state_dir/profile/bin:$PATH"
export PATH
if [ "$repository" = "$checkout" ] && [ -f "$checkout/ts/package.json" ]; then
  export DEVENV_ROOT="$checkout"
  export TAO_DEVENV=1
  export TAO_DEVENV_KIND=portable
  export PATH="$checkout/ts/node_modules/.bin:$PATH"
fi
if "$verify_setup"; then
  # What a verification lane reads and nothing else: the installed packages (adopted when a cache
  # restored them), the generated parser, the maintained native bindings, and the Tao projects' npm
  # pins. Agent configuration, Git hooks, shell completion, and the initial dev branch serve a
  # person's checkout. The two generators write disjoint trees, so they run side by side.
  printf 'Verify setup: dependencies...\n'
  just _deps
  printf 'Verify setup: native bindings and parser, side by side...\n'
  just --no-deps native-bindings &
  bindings=$!
  just --no-deps _parser-gen
  wait "$bindings"
  printf 'Verify setup: Tao project dependencies...\n'
  just --no-deps _tao-project-deps
  printf 'Verify setup: TypeScript formatter plugins...\n'
  exec "$state_dir/profile/bin/bun" install --cwd "$checkout/ts" --frozen-lockfile
fi
exec "$repository/agent" unsandboxed setup
