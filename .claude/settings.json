{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && cd \"$repo_root\" && ./agent unsandboxed setup"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-prompt-submit.zsh\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-output-discipline.zsh\" || true"
          },
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-shell-habits.zsh\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" spawn > /dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" start > /dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-subagent-brief.zsh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" stop > /dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-worktree.zsh && repo_root=\"$(git rev-parse --show-toplevel)\" && { [ -x \"$repo_root/$script\" ] || repo_root=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"; } && \"$repo_root/$script\" create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=.x-tao-old-v1/packages/cli/agent-cli/agent-cli-src/cli/agent-worktree.zsh && repo_root=\"$(git rev-parse --show-toplevel)\" && { [ -x \"$repo_root/$script\" ] || repo_root=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"; } && \"$repo_root/$script\" remove"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "./agent unsandboxed *"
    ],
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        }
      ]
    },
    "filesystem": {
      "allowWrite": [
        "./.devenv",
        "~/code/tao-lang/.devenv",
        "~/.tao",
        "~/.bun",
        "~/.cache",
        "~/.gradle",
        "~/.android",
        "~/.expo",
        "~/.hutch",
        "~/Library/Caches"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket"
      ],
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "nodejs.org",
        "*.nodejs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "hutch.blackboard.sh",
        "electrobun-artifacts.blackboard.sh",
        "ziglang.org",
        "expo.dev",
        "*.expo.dev",
        "*.expo.io",
        "exp.host",
        "repo1.maven.org",
        "repo.reactnative.dev",
        "cdn.cocoapods.org",
        "auth.docker.io",
        "registry-1.docker.io",
        "production.cloudfront.docker.com",
        "archive.ubuntu.com",
        "security.ubuntu.com",
        "releases.nixos.org",
        "cache.nixos.org",
        "*.cachix.org",
        "*.anthropic.com",
        "*.openai.com",
        "developer.apple.com",
        "*.developer.apple.com",
        "appstoreconnect.apple.com",
        "*.appstoreconnect.apple.com",
        "idmsa.apple.com",
        "appleid.apple.com",
        "gsa.apple.com",
        "contentdelivery.apple.com",
        "*.itunes.apple.com",
        "devimages-cdn.apple.com",
        "swcdn.apple.com",
        "swdist.apple.com"
      ]
    }
  },
  "autoCompactWindow": 272000,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "allow": [
      "Bash(./agent *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(file *)",
      "Bash(git branch --show-current)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git tag --list *)",
      "Bash(git worktree list *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(lsof -nP -iTCP:* -sTCP:LISTEN -t)",
      "Bash(plutil -lint *)",
      "Bash(plutil -p *)",
      "Bash(pwd)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(stat *)",
      "Bash(sw_vers *)",
      "Bash(tail *)",
      "Bash(uname *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Read(~/code/tao-lang/**)",
      "SendMessage",
      "WebFetch",
      "WebSearch",
      "mcp__Claude_Browser__*",
      "mcp__Claude_Code_iOS_Simulator__*",
      "mcp__ccd_session_mgmt__send_message",
      "mcp__claude-in-chrome__*"
    ],
    "ask": [
      "Bash(./agent dependency-add *)",
      "Bash(./agent unsandboxed dependency-add *)",
      "Bash(./agent unsandboxed verify-ci)",
      "Bash(./agent land-unlock --force*)"
    ],
    "deny": [
      "Bash(bun install *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr merge)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
