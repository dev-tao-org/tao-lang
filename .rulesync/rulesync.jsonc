{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": ["codexcli", "claudecode", "cursor"],
  // Root agent-config generates subagents for all targets and hooks for Codex and Claude.
  // Permissions, model defaults and profiles are maintained in native harness files.
  "features": ["subagents"],
  "delete": true,
}
