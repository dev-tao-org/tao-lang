# Native command rules; keep equivalents in Claude and Cursor settings synchronized.
# New host prefixes come from .config/agent-host-commands.json; the wrapper validates argv.
# Host access still depends on the invoking harness. Retained legacy operations follow its allowlist.
prefix_rule(pattern=["./agent","unsandboxed","push"], decision="allow", justification="Developer-authorized non-main branch pushes through a guard that rejects main, force, deletion and bulk pushes.")
prefix_rule(pattern=["./agent","unsandboxed","install-ide-extension"], decision="allow", justification="Developer-approved replacement of the Tao extension in Cursor and VS Code.")
prefix_rule(pattern=["./agent","unsandboxed","agent-config"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
prefix_rule(pattern=["./agent","dependency-add"], decision="prompt", justification="Registry dependency additions use a validated exact pin and require developer authorization.")
prefix_rule(pattern=["./agent","unsandboxed","dependency-add"], decision="prompt", justification="Host registry dependency additions use a validated exact pin and require developer authorization.")
prefix_rule(pattern=["./agent","unsandboxed","my-branch"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
prefix_rule(pattern=["./agent","unsandboxed","fmt"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
prefix_rule(pattern=["./agent","unsandboxed","fix"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
prefix_rule(pattern=["./agent","unsandboxed","check"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
prefix_rule(pattern=["./agent","unsandboxed","test"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
prefix_rule(pattern=["./agent","unsandboxed","verify"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
prefix_rule(pattern=["./agent","unsandboxed","verify-ci"], decision="prompt", justification="Dispatching hosted Verify for a pushed feature branch requires developer authorization.")
prefix_rule(pattern=["./agent","unsandboxed","performance","preview"], decision="allow", justification="Developer-approved isolated headless preview proof through the guarded host wrapper.")
prefix_rule(pattern=["./agent","unsandboxed","performance","modules"], decision="allow", justification="Developer-approved isolated headless module-refresh architecture comparison; no publication.")
prefix_rule(pattern=["./agent","unsandboxed","performance","record"], decision="allow", justification="Developer-approved commit-linked local performance recording; no push or landing.")
prefix_rule(pattern=["./agent","unsandboxed","doctor"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
prefix_rule(pattern=["./agent","unsandboxed","secrets"], decision="allow", justification="Repository host wrapper validates the allowlisted operation.")
