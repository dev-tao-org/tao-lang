{
  // Match the pinned TypeScript compiler used by the new workspace checks.
  "typescript.tsdk": "ts/CLIs/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.experimental.useTsgo": false,
  "typescript.experimental.useTsgo": false,
  // Build and install the IDE extension, then restart the extension host (requires extension ryuta46.multi-command).
  "tao.workspaceKeybinding.buildAndRestart": true,
  "multiCommand.commands": [
    {
      "command": "multiCommand.buildExtensionThenRestartHost",
      "interval": 6000,
      "sequence": [
        "workbench.action.tasks.build",
        "workbench.action.restartExtensionHost"
      ]
    }
  ],
  "langium.config": ".x-tao-old-v1/packages/language/parser/langium-config.json",
  // WordFlower target files use alternate extensions to stay out of Tao discovery.
  "files.associations": {
    "*.tao-next": "tao",
    "*.tao-mvp": "tao",
    "*.tao-revolution": "tao",
    "*.test.tao-next": "tao",
    "*.test.tao-mvp": "tao",
    "*.test.tao-revolution": "tao"
  },
  /////////////
  // Formatting
  "editor.defaultFormatter": "dprint.dprint",
  "editor.formatOnSave": true,
  "[tao]": {
    "editor.defaultFormatter": "devtao.tao",
    "editor.tabSize": 3,
    "editor.insertSpaces": true
  },
  /////////////////////////////
  // File and search exclusions
  // Gitignored `_gen_*` dirs are hidden from Quick Open by default; use files.exclude
  // (with an App.tsx exception) instead so compiled `packages/apps/runtime/_gen_tao-app/App.tsx` is findable.
  "explorer.excludeGitIgnore": false,
  "search.exclude": {
    "**/bun.lock": true,
    // "**/_gen_*": true,
    "!**/_gen_*/App.tsx": false
  },
  "files.exclude": {
    ".devenv": true,
    ".direnv": true,
    ".android": true,
    "**/.expo": true,
    ".gemini": true,
    ".dprint.jsonc": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/bun.lock": true,
    "!**/_gen_*/App.tsx": false,
    "devenv.lock": true,
    "devenv.yaml": true,
    "**/tsconfig.tsbuildinfo": true,
    "local.properties": true,
    ".x-tao-old-v1/**/node_modules": true,
    "old-packages/**/node_modules": true,
  },
  "js/ts.tsdk.path": "ts/CLIs/node_modules/typescript/lib"
}
